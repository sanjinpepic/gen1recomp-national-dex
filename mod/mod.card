-- Sharing metadata (25-community-and-ecosystem.md 3.2).  Read by tooling and
-- the manager's detail pane; never by the loader's merge, so nothing here can
-- break a load.
return {
  summary = "The full 1025-species national dex, modern typing, 326 forms and a read API.",
  author = "sanjinpepic",
  contact = "https://github.com/sanjinpepic",
  tags = { "content", "dex", "ui", "tool", "gen2" },
  differences = {
    changed = {
      "TYPE CHART picks an effectiveness era and it wins over the cart's own chart, so Ghost really is 2x on Psychic under MODERN",
      "the Pokedex entry page gains a STATS page on DOWN and form browsing on LEFT/RIGHT",
      "the party STATUS screen splits Special into Sp.Atk and Sp.Def when STATS: MODERN",
      "dexSize and dexDigits grow so the dex list can page past 151",
    },
    added = {
      "species 1-1025 with dex entries, typing, base stats, learnsets and evolutions",
      "326 alternate forms, nested inside their base species rather than given dex rows",
      "the DARK, STEEL and FAIRY types, and 324 modern matchups",
      "mod options: NATIONAL DEX, TYPE CHART (GEN 1 / GEN 2 / MODERN eras), STATS and MOVES",
      "833 modern moves in the move registry, so the whole roster exists by name, type and numbers",
      "MOVES: ALL widens level-up learnsets to the modern moves this engine can actually execute",
      "Gold as well as Red/Blue/Yellow: records are reshaped for the second schema the pokemon registry validates against there",
      "exports apiVersion / statsByDex / statsBySpecies / listSpecies / formsOf / splitStats / moveById / listMoves",
    },
    known = {
      "most of the 833 modern moves are registered with a placeholder effect (plain damage) because this engine cannot express what they really do; every record says which it is, and a placeholder is never taught to anything",
      "MOVES defaults to GEN-NATIVE, which leaves every learnset exactly as it is today",
      "on Gold, Metronome rolls against the whole move table, so it can call a modern move nothing has learnt; Red's Metronome rolls against the ROM's own list and is unaffected",
      "no artwork ships, so beyond-151 species render a flat-grey ? until the player supplies their own",
      "the Sp.Atk/Sp.Def split is data and display only -- battle damage still reads the ROM's collapsed Special",
      "NATIONAL DEX defaults to OFF, so a freshly enabled install changes nothing until the option is set",
      "records carry moves, abilities and EV yields this engine cannot execute; they are there for mods built on top",
      "on Gold the Pokedex STATS page and the party summary box do not install at all -- those screens are different classes there and a Gen 2 equivalent is not written yet",
      "Gold's #1-251 keep the cart's base stats on purpose: on Gen 2 those are live battle numbers, so only the typing is patched over them",
    },
  },
  credits = {
    { who = "PokeAPI (https://pokeapi.co)",
      for_ = "every species record: stats, typing, learnsets, abilities, evolutions, egg groups and EV yields" },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
